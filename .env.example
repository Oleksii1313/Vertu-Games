# Локальная отладка: скопируйте в .env (файл в .gitignore) и запустите server.py.
# Без DATABASE_URL приложение работает на локальном SQLite (data/vertu.sqlite3).
# DATABASE_URL=postgresql://user:pass@host:5432/db
# DB_POOL_SIZE=5

# SECRET_KEY обязателен на проде (резервный пароль админки, если не задан ADMIN_PASSWORD).
# SECRET_KEY=длинная-случайная-строка

# Админка: без ADMIN_PASSWORD (и без SECRET_KEY) вход в админку закрыт.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=замените-меня

# Cloudflare Turnstile: пустые ключи + TURNSTILE_REQUIRED=0 — капча выключена.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_REQUIRED=0

# Публичный адрес нужен для Secure-куки и ссылок.
# PUBLIC_URL=https://games.example.com

# Экономика
# WELCOME_COINS=100
# SHOP_PROVIDER=
